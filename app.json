{
  "expo": {
    "name": "FinancialControl",
    "slug": "financialcontrol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financialcontrol",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "es.juanantonio.financialcontrol",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleAllowMixedLocalizations": true
      },
      "deploymentTarget": "17.0",
      "appleTeamId": "8Z856TA59Z"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "es.juanantonio.financialcontrol"
    },
    "plugins": [
      "./plugins/sin-push.js",
      "./plugins/sin-sandbox-de-scripts.js",
      "./plugins/parche-libsodium.js",
      "./plugins/sin-cache-de-red.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-app-intents",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FinancialControl usa Face ID para desbloquear la app."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "Disponible",
              "displayName": "Disponible este mes",
              "description": "Lo que te queda por gastar este mes y cuánto es eso por día.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": ["app-intents"]
      }
    },
    "locales": {
      "es": "./src/i18n/nativo-es.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
